#!/bin/bash
# VS Code wrapper for the OpenAI Codex VS Code extension.
#
# The extension launches the configured binary as the Codex command. We forward
# everything to codex-docker so codex runs inside the container instead of on
# the host.
set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points at the real bin/ directory
# even when invoked via /usr/local/bin/<symlink>.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  link_dir="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
exec "$SCRIPT_DIR/codex-docker" "$@"
